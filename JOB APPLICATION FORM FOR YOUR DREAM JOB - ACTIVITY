require_once 'db.php';

// HANDLE INSERT (CREATE)
if (isset($_POST['submit'])) {
    $full_name = $_POST['full_name'];
    $email = $_POST['email'];
    $phone_number = $_POST['phone_number'];
    $years_of_experience = $_POST['years_of_experience'];
    $primary_programming_language = $_POST['primary_programming_language'];
    $preferred_framework = $_POST['preferred_framework'];
    $expected_salary = $_POST['expected_salary'];

    $sql = "INSERT INTO job_applications (full_name, email, phone_number, years_of_experience, primary_programming_language, preferred_framework, expected_salary) VALUES (?, ?, ?, ?, ?, ?, ?)";
    $stmt = $pdo->prepare($sql);
    $stmt->execute([$full_name, $email, $phone_number, $years_of_experience, $primary_programming_language, $preferred_framework, $expected_salary]);
    
    header("Location: index.php");
    exit();
}

// HANDLE DELETE
if (isset($_GET['delete_id'])) {
    $id = $_GET['delete_id'];
    $stmt = $pdo->prepare("DELETE FROM job_applications WHERE id = ?");
    $stmt->execute([$id]);
    
    header("Location: index.php");
    exit();
}

// FETCH ALL RECORDS (READ)
$stmt = $pdo->query("SELECT * FROM job_applications ORDER BY date_added DESC");
$applications = $stmt->fetchAll(PDO::FETCH_ASSOC);
?>

