 // Delete a developer
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['delete_developer'])) {
    $id = (int) ($_POST['id'] ?? 0);

    if ($id > 0) {
        try {
            $pdo->beginTransaction();

            // Find the developer before deleting.
            $stmt = $pdo->prepare(
                "SELECT id, full_name
                 FROM developers
                 WHERE id = :id
                 FOR UPDATE"
            );
            $stmt->execute([':id' => $id]);
            $developer = $stmt->fetch(PDO::FETCH_ASSOC);

            if ($developer) {
                // Record who deleted the developer.
                $stmt = $pdo->prepare(
                    "INSERT INTO developer_audit_log
                     (developer_id, developer_name, action_type, action_by)
                     VALUES (:developer_id, :developer_name, :action_type, :action_by)"
                );

                $stmt->execute([
                    ':developer_id' => $developer['id'],
                    ':developer_name' => $developer['full_name'],
                    ':action_type' => 'DELETE',
                    ':action_by' => $_SESSION['user_id']
                ]);

                // Delete the developer after recording the audit entry.
                $stmt = $pdo->prepare(
                    "DELETE FROM developers WHERE id = :id"
                );
                $stmt->execute([':id' => $id]);

                $pdo->commit();
                $message = 'Developer deleted successfully!';
            } else {
                $pdo->rollBack();
                $message = 'Developer not found.';
            }

        } catch (PDOException $e) {
            if ($pdo->inTransaction()) {
                $pdo->rollBack();
            }

            error_log('Developer deletion failed: ' . $e->getMessage());
            $message = 'Error deleting developer. They may still have related projects. No changes were saved.';
        }
    } else {
        $message = 'Invalid developer ID.';
    }
