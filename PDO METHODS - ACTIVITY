<?php
// Database configuration for Thai Grocery Store
$host = 'localhost';
$dbname = 'thai_grocery_store';
$username = 'root';
$password = '';

try {
    // Establish connection to MySQL database using PDO
    $pdo = new PDO("mysql:host=$host;dbname=$dbname;charset=utf8mb4", $username, $password);
    
    // Set PDO error mode to exception for handling connection errors
    $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

} catch (PDOException $e) {
    // Handle database connection failure gracefully
    die("Connection failed: " . $e->getMessage());
}
?>

