-- =========================================================
-- 3. SQL DEMONSTRATION QUERIES (WHERE, JOIN, GROUP BY, AGGREGATES)
-- =========================================================

-- Query 1 (WHERE & JOIN): List all products priced above $100 with their category names
SELECT 
    p.product_id, 
    p.product_name, 
    c.category_name, 
    p.price
FROM Products p
JOIN Categories c ON p.category_id = c.category_id
WHERE p.price > 100.00;

-- Query 2 (JOIN & WHERE): Show order details for orders that are already 'Shipped'
SELECT 
    o.order_id,
    cust.full_name AS customer_name,
    p.product_name,
    oi.quantity,
    o.status
FROM Orders o
JOIN Customers cust ON o.customer_id = cust.customer_id
JOIN Order_Items oi ON o.order_id = oi.order_id
JOIN Products p ON oi.product_id = p.product_id
WHERE o.status = 'Shipped';

-- Query 3 (GROUP BY & AGGREGATE): Calculate the total spending and order count per customer
SELECT 
    cust.full_name AS customer_name,
    COUNT(o.order_id) AS total_orders_placed,
    SUM(o.total_amount) AS total_amount_spent
FROM Customers cust
JOIN Orders o ON cust.customer_id = o.customer_id
GROUP BY cust.customer_id, cust.full_name;

-- Query 4 (GROUP BY & AGGREGATE): Count total products and average price per category
SELECT 
    c.category_name,
    COUNT(p.product_id) AS total_products,
    ROUND(AVG(p.price), 2) AS average_price
FROM Categories c
LEFT JOIN Products p ON c.category_id = p.category_id
GROUP BY c.category_id, c.category_name;
