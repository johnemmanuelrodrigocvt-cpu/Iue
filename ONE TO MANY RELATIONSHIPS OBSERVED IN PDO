<?php
require_once 'config/database.php';

$message = '';

// Add a developer
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['add_developer'])) {
    $full_name = trim($_POST['full_name']);
    $email = trim($_POST['email']);
    $specialty = trim($_POST['specialty']);

    if ($full_name !== '' && $email !== '' && $specialty !== '') {
        try {
            $sql = "INSERT INTO developers (full_name, email, specialty)
                    VALUES (:full_name, :email, :specialty)";
            $stmt = $pdo->prepare($sql);
            $stmt->execute([
                ':full_name' => $full_name,
                ':email' => $email,
                ':specialty' => $specialty
            ]);

            $message = 'Developer added successfully!';
        } catch (PDOException $e) {
            $message = 'Error adding developer. Check whether the email is already used.';
        }
    } else {
        $message = 'Please fill in all fields.';
    }
}


 // Update a developer
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['update_developer'])) {
    $id = (int) $_POST['id'];
    $full_name = trim($_POST['full_name']);
    $email = trim($_POST['email']);
    $specialty = trim($_POST['specialty']);

    if ($id > 0 && $full_name !== '' && $email !== '' && $specialty !== '') {
        try {
            $sql = "UPDATE developers
                    SET full_name = :full_name,
                        email = :email,
                        specialty = :specialty
                    WHERE id = :id";

            $stmt = $pdo->prepare($sql);
            $stmt->execute([
                ':full_name' => $full_name,
                ':email' => $email,
                ':specialty' => $specialty,
                ':id' => $id
            ]);

            $message = 'Developer updated successfully!';
        } catch (PDOException $e) {
            $message = 'Error updating developer. Check whether the email is already used.';
        }
    } else {
        $message = 'Please fill in all fields.';
    }
}


 // Delete a developer
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['delete_developer'])) {
    $id = (int) ($_POST['id'] ?? 0);

    if ($id > 0) {
        try {
            $stmt = $pdo->prepare(
                "DELETE FROM developers WHERE id = :id"
            );
            $stmt->execute([':id' => $id]);

            if ($stmt->rowCount() > 0) {
                $message = 'Developer deleted successfully!';
            } else {
                $message = 'Developer not found.';
            }
        } catch (PDOException $e) {
            $message = 'Error deleting developer. They may still have related projects.';
        }
    } else {
        $message = 'Invalid developer ID.';
    }
}


// Get all developers
$stmt = $pdo->query("SELECT * FROM developers ORDER BY id DESC");
$developers = $stmt->fetchAll();

?>

